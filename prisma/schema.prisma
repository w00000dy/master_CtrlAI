generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output = "ERD.pdf"
}

datasource db {
  provider = "mysql"
}

model Document {
  id         Int         @id @default(autoincrement())
  title      String
  savedAt    DateTime    @default(now())
  sections   Section[]
  guidelines Guideline[]
}

model Guideline {
  id         Int       @id @default(autoincrement())
  title      String
  savedAt    DateTime  @default(now())
  controls   Control[]
  documentId Int
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Section {
  id         Int         @id @default(autoincrement())
  marker     String?
  title      String
  documentId Int
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  paragraphs Paragraph[]
}

model Paragraph {
  id                    Int                 @id @default(autoincrement())
  marker                String?
  text                  String              @db.Text
  sectionId             Int
  section               Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  parentParagraphId     Int?
  parentParagraph       Paragraph?          @relation("SubParagraphs", fields: [parentParagraphId], references: [id], onDelete: Cascade)
  subParagraphs         Paragraph[]         @relation("SubParagraphs")
  controls              Control[]
  generatedControls     Control[]           @relation("GeneratedForParagraph")
  benchmarkResult       ParagraphBenchmark?
  relevantForBenchmarks BenchmarkResult[]   @relation("RelevantBenchmarkParagraphs")
  isFewShotExample      Boolean             @default(false)
}

model Control {
  id                     Int         @id @default(autoincrement())
  title                  String
  statement              String      @db.Text
  implementationGuidance String?     @db.Text
  guidelineId            Int?
  guideline              Guideline?  @relation(fields: [guidelineId], references: [id], onDelete: Cascade)
  paragraphs             Paragraph[]

  generatedForId         Int?
  generatedFor           Paragraph?  @relation("GeneratedForParagraph", fields: [generatedForId], references: [id], onDelete: SetNull)

  benchmarkResult     BenchmarkResult?  @relation("LlmControlBenchmark")
  coveredByBenchmarks BenchmarkResult[] @relation("CoveredByBenchmark")
}

model BenchmarkResult {
  id           Int     @id @default(autoincrement())
  llmControlId Int     @unique
  llmControl   Control @relation("LlmControlBenchmark", fields: [llmControlId], references: [id], onDelete: Cascade)

  coveredControls Control[] @relation("CoveredByBenchmark")

  relevantParagraphs Paragraph[] @relation("RelevantBenchmarkParagraphs")

  isActionable         Boolean
  isTechnicallyCorrect Boolean

  createdAt DateTime @default(now())
}

model ParagraphBenchmark {
  id          Int       @id @default(autoincrement())
  paragraphId Int       @unique
  paragraph   Paragraph @relation(fields: [paragraphId], references: [id], onDelete: Cascade)

  isComplete    Boolean
  hasRedundancy Boolean

  createdAt DateTime @default(now())
}
