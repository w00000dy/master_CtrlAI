generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Document {
  id         Int         @id @default(autoincrement())
  title      String
  savedAt    DateTime    @default(now())
  sections   Section[]
  guidelines Guideline[]
}

model Guideline {
  id         Int       @id @default(autoincrement())
  title      String
  savedAt    DateTime  @default(now())
  controls   Control[]
  documentId Int
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Section {
  id         Int         @id @default(autoincrement())
  marker     String?
  title      String
  documentId Int
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  paragraphs Paragraph[]
}

model Paragraph {
  id                Int         @id @default(autoincrement())
  marker            String?
  text              String      @db.Text
  sectionId         Int
  section           Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  parentParagraphId Int?
  parentParagraph   Paragraph?  @relation("SubParagraphs", fields: [parentParagraphId], references: [id], onDelete: Cascade)
  subParagraphs     Paragraph[] @relation("SubParagraphs")
  controls          Control[]
}

model Control {
  id                     Int         @id @default(autoincrement())
  title                  String
  statement              String      @db.Text
  implementationGuidance String?     @db.Text
  guidelineId            Int?
  guideline              Guideline?  @relation(fields: [guidelineId], references: [id], onDelete: Cascade)
  paragraphs             Paragraph[]
}
